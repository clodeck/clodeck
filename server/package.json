{
  "name": "@clodeck/server",
  "version": "0.0.0",
  "private": true,
  "description": "Clodeck backend: Agent SDK sessions, project discovery, and the HTTP/WS surface",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "dev:fake": "tsx watch src/testing/dev-fake.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@clodeck/shared": "*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.5",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
