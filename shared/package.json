{
  "name": "@clodeck/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Domain types and transport contracts shared by the Clodeck server and web client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
