{
  // The browser half of the baseline: same strict rules, DOM libs, bundler
  // resolution. Vite does the emitting, so this config never emits.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true
  },
  // `e2e` and `playwright.config.ts` are here so the pre-commit `typecheck`
  // covers the end-to-end suite too — otherwise it would be the one corner of
  // the repo nothing compiles.
  "include": ["src", "e2e", "vite.config.ts", "vite.config.test.ts", "playwright.config.ts"]
}
