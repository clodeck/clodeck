{
  "name": "@clodeck/web",
  "version": "0.0.0",
  "private": true,
  "description": "Clodeck web client: project switcher, chat, terminal, and file viewer",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json && vite build",
    "typecheck": "tsc --project tsconfig.json",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@clodeck/shared": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
